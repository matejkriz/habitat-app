# Convex
CONVEX_URL="https://your-deployment.convex.cloud"

# Shared secret between Next.js and Convex (configure the same value in both)
PUSH_INTERNAL_SECRET="replace-with-a-long-random-value"

# Public Web Push key; keep its matching private key only in Convex
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-the-environment-public-vapid-key"

# WorkOS AuthKit (https://dashboard.workos.com)
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
WORKOS_COOKIE_PASSWORD="replace-with-at-least-32-random-characters"
# Portless and Vercel supply callback hosts dynamically. Set this only for a custom deployment domain.
# NEXT_PUBLIC_WORKOS_REDIRECT_URI="https://your-domain.example/callback"

# Parent excuse MCP (server-only; configure separately for develop and production)
MCP_RESOURCE_URL="https://your-domain.example/api/mcp"
WORKOS_AUTHKIT_DOMAIN="https://your-project.authkit.app"
MCP_CONFIRMATION_SECRET="replace-with-a-separate-long-random-value"

# Development personas (never enable in production)
DEV_PERSONA_SWITCHER="true"

# Incoming webhook bound to this environment's Slack channel
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Earliest month available in the attendance calendar
NEXT_PUBLIC_ATTENDANCE_CALENDAR_START_DATE="2026-07-01"
