# Convex
CONVEX_URL="https://your-deployment.convex.cloud"

# WorkOS AuthKit (https://dashboard.workos.com)
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
WORKOS_COOKIE_PASSWORD="replace-with-at-least-32-random-characters"
# Portless supplies the local callback dynamically. Set this only when deployed.
# NEXT_PUBLIC_WORKOS_REDIRECT_URI="https://your-domain.example/callback"

# Development personas (never enable in production)
DEV_PERSONA_SWITCHER="true"
