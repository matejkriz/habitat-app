{
  "name": "habitat-app",
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "private": true,
  "scripts": {
    "dev": "portless run next dev --webpack",
    "build": "next build --webpack",
    "build:vercel": "if [ -n \"$CONVEX_DEPLOY_KEY\" ]; then convex deploy --cmd 'pnpm build' --cmd-url-env-var-name CONVEX_URL; else pnpm build; fi",
    "generate:pwa-startup": "node scripts/generate-ios-startup-images.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "convex:dev": "CONVEX_DISABLE_TELEMETRY=1 convex dev",
    "convex:deploy": "CONVEX_DISABLE_TELEMETRY=1 convex deploy",
    "convex:codegen": "CONVEX_DISABLE_TELEMETRY=1 convex codegen --typecheck disable",
    "seed:dev": "CONVEX_DISABLE_TELEMETRY=1 convex run seed:development '{}' --push --typecheck disable",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/run-e2e-ci.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.10.0",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "dotenv": "^17.2.3",
    "jose": "^6.2.10",
    "mcp-handler": "^2.1.1",
    "next": "16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.0.18",
    "@workos/emulate": "^0.13.0",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "happy-dom": "^20.1.0",
    "portless": "^0.15.5",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.16"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
